{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/go-kure/.github/blob/main/governance/repository-settings-policy.schema.json",
  "title": "Repository settings policy",
  "description": "The closed shape of governance/repository-settings-policy.yaml (or a consumer's POLICY_FILE), checked by scripts/github-settings.sh before any audit or --apply. Every object is closed: a key the script does not read is refused, because its exact lookups would miss it and apply the default instead. The key sets are pinned to the script's registries (SETTING_KEYS, ORG_SETTING_KEYS, ORG_READONLY_KEYS, ORG_ACTIONS_*_KEYS, RULE_TYPE_ORDER) by scripts/test/github-settings-test.sh. Only the draft-07 subset scripts/lib/json-schema.sh implements may be used here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["github_defaults"],
  "properties": {
    "github_defaults": { "$ref": "#/definitions/defaults" },
    "github_repos": {
      "description": "Per-repo overrides, keyed by repo name. The names are checked against GITHUB_REPOS_DEFAULT and GITHUB_REPOS by validate_policy, not here.",
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/definitions/repo_override" }
    },
    "github_org": { "$ref": "#/definitions/org" }
  },
  "definitions": {
    "defaults": {
      "description": "Org-wide repo defaults. Every SETTING_KEYS entry and every security key is required, so the audit never compares a live value against a missing default or skips a governed setting.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_rebase_merge", "allow_squash_merge", "allow_merge_commit", "delete_branch_on_merge",
        "allow_update_branch", "has_wiki", "allow_auto_merge", "has_projects", "has_issues",
        "has_discussions", "has_downloads", "is_template", "allow_forking", "web_commit_signoff_required",
        "merge_commit_title", "merge_commit_message", "squash_merge_commit_title", "squash_merge_commit_message",
        "security", "rulesets"
      ],
      "properties": {
        "allow_rebase_merge": { "type": "boolean" },
        "allow_squash_merge": { "type": "boolean" },
        "allow_merge_commit": { "type": "boolean" },
        "delete_branch_on_merge": { "type": "boolean" },
        "allow_update_branch": { "type": "boolean" },
        "has_wiki": { "type": "boolean" },
        "allow_auto_merge": { "type": "boolean" },
        "has_projects": { "type": "boolean" },
        "has_issues": { "type": "boolean" },
        "has_discussions": { "type": "boolean" },
        "has_downloads": { "type": "boolean" },
        "is_template": { "type": "boolean" },
        "allow_forking": { "type": "boolean" },
        "web_commit_signoff_required": { "type": "boolean" },
        "merge_commit_title": { "$ref": "#/definitions/merge_commit_title" },
        "merge_commit_message": { "$ref": "#/definitions/merge_commit_message" },
        "squash_merge_commit_title": { "$ref": "#/definitions/squash_merge_commit_title" },
        "squash_merge_commit_message": { "$ref": "#/definitions/squash_merge_commit_message" },
        "security": { "$ref": "#/definitions/security_defaults" },
        "rulesets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/ruleset_default" }
        }
      }
    },
    "repo_override": {
      "description": "One repo's overrides: any github_defaults key, none required. A ruleset here either overrides the github_defaults ruleset of the same name or, with no such default, is a ruleset of this repo only.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "allow_rebase_merge": { "type": "boolean" },
        "allow_squash_merge": { "type": "boolean" },
        "allow_merge_commit": { "type": "boolean" },
        "delete_branch_on_merge": { "type": "boolean" },
        "allow_update_branch": { "type": "boolean" },
        "has_wiki": { "type": "boolean" },
        "allow_auto_merge": { "type": "boolean" },
        "has_projects": { "type": "boolean" },
        "has_issues": { "type": "boolean" },
        "has_discussions": { "type": "boolean" },
        "has_downloads": { "type": "boolean" },
        "is_template": { "type": "boolean" },
        "allow_forking": { "type": "boolean" },
        "web_commit_signoff_required": { "type": "boolean" },
        "merge_commit_title": { "$ref": "#/definitions/merge_commit_title" },
        "merge_commit_message": { "$ref": "#/definitions/merge_commit_message" },
        "squash_merge_commit_title": { "$ref": "#/definitions/squash_merge_commit_title" },
        "squash_merge_commit_message": { "$ref": "#/definitions/squash_merge_commit_message" },
        "security": { "$ref": "#/definitions/security" },
        "rulesets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/ruleset_override" }
        }
      }
    },
    "merge_commit_title": { "type": "string", "enum": ["PR_TITLE", "MERGE_MESSAGE"] },
    "merge_commit_message": { "type": "string", "enum": ["PR_BODY", "PR_TITLE", "BLANK"] },
    "squash_merge_commit_title": { "type": "string", "enum": ["PR_TITLE", "COMMIT_OR_PR_TITLE"] },
    "squash_merge_commit_message": { "type": "string", "enum": ["PR_BODY", "COMMIT_MESSAGES", "BLANK"] },
    "security": {
      "description": "security_and_analysis status strings. --apply treats anything but \"enabled\" as a request to turn the setting off, so a value outside the enum must never reach it.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "secret_scanning": { "$ref": "#/definitions/status" },
        "secret_scanning_push_protection": { "$ref": "#/definitions/status" },
        "dependabot_security_updates": { "$ref": "#/definitions/status" }
      }
    },
    "security_defaults": {
      "description": "The github_defaults security block. Unlike an override, it must set all three keys: audit_security_settings skips a key no tier declares, so an omitted default would silently stop governing it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_scanning", "secret_scanning_push_protection", "dependabot_security_updates"],
      "properties": {
        "secret_scanning": { "$ref": "#/definitions/status" },
        "secret_scanning_push_protection": { "$ref": "#/definitions/status" },
        "dependabot_security_updates": { "$ref": "#/definitions/status" }
      }
    },
    "status": { "type": "string", "enum": ["enabled", "disabled"] },
    "ruleset_default": {
      "description": "A github_defaults ruleset. repos scopes it (absent: every governed repo; []: none). bypass_actors is per-repo only and is never read here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repos": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "target": { "$ref": "#/definitions/target" },
        "enforcement": { "$ref": "#/definitions/enforcement" },
        "conditions": { "$ref": "#/definitions/conditions" },
        "rules": { "$ref": "#/definitions/rules" }
      }
    },
    "ruleset_override": {
      "description": "A github_repos.<repo> ruleset. Scope comes from github_defaults (repos is never read here). rules deep-merge over the default's; conditions replace them whole.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/definitions/target" },
        "enforcement": { "$ref": "#/definitions/enforcement" },
        "conditions": { "$ref": "#/definitions/conditions" },
        "bypass_actors": { "type": "array", "items": { "$ref": "#/definitions/bypass_actor" } },
        "rules": { "$ref": "#/definitions/rules" }
      }
    },
    "target": { "type": "string", "enum": ["branch", "tag", "push"] },
    "enforcement": { "type": "string", "enum": ["active", "evaluate", "disabled"] },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref_name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "$ref": "#/definitions/ref_patterns" },
            "exclude": { "$ref": "#/definitions/ref_patterns" }
          }
        }
      }
    },
    "ref_patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "bypass_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "bypass_mode"],
      "properties": {
        "actor_id": { "type": ["integer", "null"] },
        "actor_type": { "type": "string", "enum": ["Integration", "OrganizationAdmin", "RepositoryRole", "Team", "DeployKey", "User"] },
        "bypass_mode": { "type": "string", "enum": ["always", "pull_request", "exempt"] }
      }
    },
    "rules": {
      "description": "One key per RULE_TYPE_ORDER entry. A flag rule is a boolean (emitted only when true); every other rule is its parameters object.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deletion": { "type": "boolean" },
        "non_fast_forward": { "type": "boolean" },
        "required_linear_history": { "type": "boolean" },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_approving_review_count": { "type": "integer", "minimum": 0, "maximum": 10 },
            "dismiss_stale_reviews_on_push": { "type": "boolean" },
            "require_code_owner_review": { "type": "boolean" },
            "require_last_push_approval": { "type": "boolean" },
            "required_review_thread_resolution": { "type": "boolean" },
            "require_extra_approval_for_unattributed_changes": { "type": "boolean" },
            "allowed_merge_methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["merge", "squash", "rebase"] }
            }
          }
        },
        "required_status_checks": {
          "description": "Policy shape, not the API's: RULE_TO_API_JQ maps strict and contexts onto strict_required_status_checks_policy and required_status_checks.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strict": { "type": "boolean" },
            "contexts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "do_not_enforce_on_create": { "type": "boolean" }
          }
        },
        "merge_queue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "merge_method": { "type": "string", "enum": ["MERGE", "SQUASH", "REBASE"] },
            "grouping_strategy": { "type": "string", "enum": ["ALLGREEN", "HEADGREEN"] },
            "min_entries_to_merge": { "type": "integer", "minimum": 0, "maximum": 100 },
            "max_entries_to_merge": { "type": "integer", "minimum": 0, "maximum": 100 },
            "max_entries_to_build": { "type": "integer", "minimum": 0, "maximum": 100 },
            "min_entries_to_merge_wait_minutes": { "type": "integer", "minimum": 0, "maximum": 360 },
            "check_response_timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 360 }
          }
        },
        "copilot_code_review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review_on_push": { "type": "boolean" },
            "review_draft_pull_requests": { "type": "boolean" }
          }
        }
      }
    },
    "org": {
      "description": "Organization settings, read only behind --org. Every ORG_SETTING_KEYS and ORG_READONLY_KEYS entry and every actions key is required: the actions endpoints are PUT full-replace, so a missing key would be sent as null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_repository_permission", "members_can_create_repositories",
        "members_can_create_public_repositories", "members_can_create_private_repositories",
        "members_can_create_internal_repositories", "members_can_fork_private_repositories",
        "members_can_delete_repositories", "members_can_change_repo_visibility", "members_can_delete_issues",
        "members_can_invite_outside_collaborators", "members_can_create_pages", "members_can_create_public_pages",
        "members_can_create_private_pages", "members_can_create_teams", "has_organization_projects",
        "has_repository_projects", "readers_can_create_discussions", "members_can_view_dependency_insights",
        "display_commenter_full_name_setting_enabled", "deploy_keys_enabled_for_repositories",
        "web_commit_signoff_required", "dependabot_alerts_enabled_for_new_repositories",
        "dependabot_security_updates_enabled_for_new_repositories", "dependency_graph_enabled_for_new_repositories",
        "secret_scanning_enabled_for_new_repositories", "secret_scanning_push_protection_enabled_for_new_repositories",
        "secret_scanning_push_protection_custom_link_enabled", "secret_scanning_validity_checks_enabled",
        "two_factor_requirement_enabled", "advanced_security_enabled_for_new_repositories",
        "default_repository_branch", "members_allowed_repository_creation_type",
        "actions"
      ],
      "properties": {
        "default_repository_permission": { "type": "string", "enum": ["read", "write", "admin", "none"] },
        "members_can_create_repositories": { "type": "boolean" },
        "members_can_create_public_repositories": { "type": "boolean" },
        "members_can_create_private_repositories": { "type": "boolean" },
        "members_can_create_internal_repositories": { "type": "boolean" },
        "members_can_fork_private_repositories": { "type": "boolean" },
        "members_can_delete_repositories": { "type": "boolean" },
        "members_can_change_repo_visibility": { "type": "boolean" },
        "members_can_delete_issues": { "type": "boolean" },
        "members_can_invite_outside_collaborators": { "type": "boolean" },
        "members_can_create_pages": { "type": "boolean" },
        "members_can_create_public_pages": { "type": "boolean" },
        "members_can_create_private_pages": { "type": "boolean" },
        "members_can_create_teams": { "type": "boolean" },
        "has_organization_projects": { "type": "boolean" },
        "has_repository_projects": { "type": "boolean" },
        "readers_can_create_discussions": { "type": "boolean" },
        "members_can_view_dependency_insights": { "type": "boolean" },
        "display_commenter_full_name_setting_enabled": { "type": "boolean" },
        "deploy_keys_enabled_for_repositories": { "type": "boolean" },
        "web_commit_signoff_required": { "type": "boolean" },
        "dependabot_alerts_enabled_for_new_repositories": { "type": "boolean" },
        "dependabot_security_updates_enabled_for_new_repositories": { "type": "boolean" },
        "dependency_graph_enabled_for_new_repositories": { "type": "boolean" },
        "secret_scanning_enabled_for_new_repositories": { "type": "boolean" },
        "secret_scanning_push_protection_enabled_for_new_repositories": { "type": "boolean" },
        "secret_scanning_push_protection_custom_link_enabled": { "type": "boolean" },
        "secret_scanning_validity_checks_enabled": { "type": "boolean" },
        "two_factor_requirement_enabled": { "type": "boolean" },
        "advanced_security_enabled_for_new_repositories": { "type": "boolean" },
        "default_repository_branch": { "type": "string", "minLength": 1 },
        "members_allowed_repository_creation_type": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled_repositories", "allowed_actions", "sha_pinning_required",
            "default_workflow_permissions", "can_approve_pull_request_reviews"
          ],
          "properties": {
            "enabled_repositories": { "type": "string", "enum": ["all", "none", "selected"] },
            "allowed_actions": { "type": "string", "enum": ["all", "local_only", "selected"] },
            "sha_pinning_required": { "type": "boolean" },
            "default_workflow_permissions": { "type": "string", "enum": ["read", "write"] },
            "can_approve_pull_request_reviews": { "type": "boolean" }
          }
        }
      }
    }
  }
}
