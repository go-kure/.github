{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Standard issue labels for go-kure repos. See labels.md for naming conventions.",
  "labels": [
    {
      "name": "status/deferred",
      "color": "#FEF2C0",
      "description": "Blocked or postponed for later"
    },
    {
      "name": "status/blocked",
      "color": "#D93F0B",
      "description": "Blocked by external dependency"
    },
    {
      "name": "status/needs-review",
      "color": "#0E8A16",
      "description": "Awaiting review"
    },
    {
      "name": "status/in-progress",
      "color": "#1D76DB",
      "description": "Currently being worked on"
    },
    {
      "name": "priority/critical",
      "color": "#B60205",
      "description": "Must be fixed immediately"
    },
    {
      "name": "priority/high",
      "color": "#D93F0B",
      "description": "Important, fix soon"
    },
    {
      "name": "priority/medium",
      "color": "#FBCA04",
      "description": "Normal priority"
    },
    {
      "name": "priority/low",
      "color": "#0E8A16",
      "description": "Nice to have, not urgent"
    },
    {
      "name": "type/design",
      "color": "#C5DEF5",
      "description": "Design document or RFC"
    },
    {
      "name": "type/epic",
      "color": "#0052CC",
      "description": "Epic or umbrella issue"
    },
    {
      "name": "type/roadmap",
      "color": "#D4AF37",
      "description": "Master tracking, strategic roadmap, or program-level umbrella issue"
    },
    {
      "name": "type/upgrade",
      "color": "#C5DEF5",
      "description": "Dependency upgrade or version bump"
    },
    {
      "name": "type/breaking-change",
      "color": "#B60205",
      "description": "Introduces breaking changes"
    },
    {
      "name": "type/security",
      "color": "#D93F0B",
      "description": "Security-related issue or fix"
    },
    {
      "name": "type/chore",
      "color": "#C5DEF5",
      "description": "Maintenance and housekeeping"
    },
    {
      "name": "type/refactor",
      "color": "#C5DEF5",
      "description": "Code refactoring"
    },
    {
      "name": "type/testing",
      "color": "#BFD4F2",
      "description": "Testing improvements"
    },
    {
      "name": "type/ci",
      "color": "#000000",
      "description": "CI/CD related"
    },
    {
      "name": "type/documentation",
      "color": "#BFD4F2",
      "description": "Documentation changes"
    },
    {
      "name": "type/bug",
      "color": "#d73a4a",
      "description": "Something isn't working"
    },
    {
      "name": "type/feature",
      "color": "#a2eeef",
      "description": "New feature or request"
    },
    {
      "name": "area/cli",
      "color": "#5319E7",
      "description": "Command-line interface"
    },
    {
      "name": "area/core",
      "color": "#5319E7",
      "description": "Core engine or library logic"
    },
    {
      "name": "area/docs",
      "color": "#5319E7",
      "description": "Documentation and design docs"
    },
    {
      "name": "area/flux",
      "color": "#5319E7",
      "description": "FluxCD resources and reconciliation"
    },
    {
      "name": "area/helm",
      "color": "#5319E7",
      "description": "Helm chart rendering and compatibility"
    },
    {
      "name": "area/k8s",
      "color": "#5319E7",
      "description": "Kubernetes resource generation"
    },
    {
      "name": "area/layout",
      "color": "#5319E7",
      "description": "Repository layout and directory structure"
    },
    {
      "name": "area/oam",
      "color": "#5319E7",
      "description": "OAM component/trait model",
      "repos": ["launcher"]
    },
    {
      "name": "area/distribution",
      "color": "#5319E7",
      "description": "Packaging and OCI distribution",
      "repos": ["launcher"]
    },
    {
      "name": "scope/launcher",
      "color": "#5319E7",
      "description": "Self-contained; no external consumer contract"
    },
    {
      "name": "scope/downstream",
      "color": "#5319E7",
      "description": "Changes a surface an external consumer imports"
    },
    {
      "name": "effort/low",
      "color": "#0E8A16",
      "description": "Small task, single pattern change"
    },
    {
      "name": "effort/medium",
      "color": "#FBCA04",
      "description": "Moderate task, some design needed"
    },
    {
      "name": "effort/high",
      "color": "#D93F0B",
      "description": "Large task, cross-repo or new patterns"
    },
    {
      "name": "upstream/kure",
      "color": "#D93F0B",
      "description": "Blocked on kure changes"
    },
    {
      "name": "dependencies",
      "color": "#0366D6",
      "description": "Dependency updates"
    },
    {
      "name": "github_actions",
      "color": "#2088FF",
      "description": "GitHub Actions workflow or CI configuration"
    },
    {
      "name": "go",
      "color": "#00ADD8",
      "description": "Go language, toolchain, or module update"
    },
    {
      "name": "docs-skip",
      "color": "#FBCA04",
      "description": "Maintainer-only: bypass the documentation-sync CI gate",
      "repos": ["launcher"]
    },
    {
      "name": "pin-impact-ack",
      "color": "#006B75",
      "description": "Acknowledges a reviewed go-kure/.github pin bump's blast-radius report; informational only",
      "repos": ["kure", "launcher"]
    },
    {
      "name": "needs-human",
      "color": "#D93F0B",
      "description": "Renovate: update needs human review before merge",
      "repos": ["kure", "launcher", ".github"]
    },
    {
      "name": "unattended",
      "color": "#0E8A16",
      "description": "Renovate: update eligible for automerge without review",
      "repos": ["kure", "launcher", ".github"]
    },
    {
      "name": "security",
      "color": "#EE0701",
      "description": "Renovate: update fixes a known vulnerability (vulnerabilityAlerts)",
      "repos": ["kure", "launcher", ".github"]
    }
  ]
}
